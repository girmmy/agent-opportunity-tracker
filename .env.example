# Copy to .env.local for local dev, and set the same keys in Vercel's
# Project Settings -> Environment Variables for production.
#
# NOTHING IN HERE IS A REAL VALUE. Never commit a filled-in .env.local.

# --- Auth -------------------------------------------------------------
# Generated by: npm run hash-password
# It prompts for a password, prints the hash, and never stores or transmits
# the password itself. Paste ONLY the printed hash here.
APP_PASSWORD_HASH=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Supabase ---------------------------------------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# The "Secret" key from Settings -> API Keys (starts with sb_secret_).
# This is the new name for the old service_role key; SUPABASE_SERVICE_ROLE_KEY
# is still accepted for older projects. Server-side only: it bypasses RLS, so
# it must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Postgres connection string, used ONLY by `npm run migrate` (never by the app
# at runtime, so it does not need to be set in Vercel).
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# If the password contains special characters, percent-encode them (@ -> %40).
DATABASE_URL=

# --- Automation -------------------------------------------------------
# Bearer token the weekly job-search agent uses to POST new opportunities.
# Generate the same way as AUTH_SECRET.
AGENT_API_TOKEN=
