# Copy to .env.local for local development, and set the same keys in Vercel
# under Project Settings -> Environment Variables.
#
# NOTHING HERE IS A REAL VALUE. Never commit a filled-in .env.local.

# --- Auth -------------------------------------------------------------
# Generate all three of these with:  npm run hash-password
# It prompts for a password, prints the values, and never stores or transmits
# the password itself. Paste only what it prints.

# PBKDF2 hash of your password. Note the ':' separators — NOT '$'. Env file
# loaders expand '$' as a variable reference and would silently corrupt this,
# which shows up as the app rejecting your correct password forever.
APP_PASSWORD_HASH=

# Random secret used to sign the session cookie. Changing it signs out every
# device, which is also the break-glass move if a session is ever compromised.
AUTH_SECRET=

# --- Supabase ---------------------------------------------------------
# Supabase dashboard -> Settings -> API Keys

# Project URL, e.g. https://abcdefgh.supabase.co
# Use the plain project URL, NOT the Data API URL that ends in /rest/v1/ —
# the client appends that path itself. (It's normalized defensively anyway.)
NEXT_PUBLIC_SUPABASE_URL=

# The "Secret" key (starts with sb_secret_). This is the current name for what
# Supabase used to call service_role; SUPABASE_SERVICE_ROLE_KEY is still
# accepted for older projects. Server-side only — it bypasses row-level
# security, so never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Optional ---------------------------------------------------------

# Shown in the dashboard greeting: "Good evening, <name>". Leave unset for a
# plain "Good evening".
OWNER_NAME=

# Bearer token for POSTing opportunities to /api/agent/opportunities from a
# script or automation. Only needed if you use that endpoint.
AGENT_API_TOKEN=

# --- Local tooling only -----------------------------------------------
# Postgres connection string, used ONLY by `npm run migrate`. The running app
# never reads it, so do NOT add this one to Vercel — a superuser connection
# string in the deployment environment is exposure for no benefit.
# Supabase dashboard -> Connect -> Direct connection.
# Percent-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=
